<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:EBTWeather.Avalonia.Views"
        xmlns:vm="clr-namespace:EBTWeather.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="420"
        Width="600"
        MinWidth="600"
        Height="420"
        MinHeight="420"
        x:Class="EBTWeather.Avalonia.Views.EditLocationDialog"
        x:DataType="vm:ManageLocationsDialogViewModel"
        WindowStartupLocation="CenterOwner"
        Title="Edit Location">
        <StackPanel 
                Orientation="Vertical" 
                Margin="10">
                <views:LocationView Name="LocationView" />
                <Button 
                        Name="SaveButton"
                        Content="_Save"
                        Command="{Binding AddCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        Margin="0, 20, 0, 0">
                </Button>
                <Button 
                        Content="_Close"
                        Margin="0, 30, 0, 0"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding $parent[Window]}" />
        </StackPanel>
</Window>