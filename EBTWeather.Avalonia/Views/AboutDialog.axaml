<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EBTWeather.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        Width="500"
        MinWidth="500"
        Height="400"
        MinHeight="400"
        x:Class="EBTWeather.Avalonia.Views.AboutDialog"
        x:DataType="vm:AboutDialogViewModel"
        Title="About EBT Weather"
        WindowStartupLocation="CenterOwner"
        CanMinimize="False"
>
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Grid 
        RowDefinitions="Auto,Auto,Auto,Auto"
        Margin="10"
        RowSpacing="10">
        <StackPanel
            Grid.Row="0"
            DockPanel.Dock="Top"
            Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="EBT Weather Version " />
                <TextBlock Text="{Binding Version}" />
            </StackPanel>
            <TextBlock Text="(C) Copyright 2026, Eric Bergman-Terrell" />
            <HyperlinkButton Content="www.EricBT.com" NavigateUri="https://www.EricBT.com" />
            <StackPanel 
                Orientation="Vertical"
                Margin="0, 10, 0, 0"
                >
                <TextBlock Text="Weather data provided by Open-Meteo:" />
                <StackPanel Orientation="Horizontal">
                    <HyperlinkButton 
                        Content="open-meteo" 
                        NavigateUri="https://open-meteo.com/"
                        Margin="0, 10, 0, 10"
                    />
                    <HyperlinkButton 
                        Content="status" 
                        NavigateUri="https://status.open-meteo.com/"
                        Margin="0, 10, 0, 10"
                    />
                </StackPanel>
                <TextBlock 
                    Text="EBT Weather was developed with the Avalonia cross-platform UI framework:"
                    TextWrapping="Wrap"
                />
                <HyperlinkButton 
                    Content="Avalonia" 
                    NavigateUri="https://avaloniaui.net/"
                    Margin="0, 10, 0, 0"
                />
                <TextBlock 
                    Text="EBT Weather runs on Windows and Linux."
                    Margin="0, 10, 0, 0"/>
            </StackPanel>
        </StackPanel>
        <Button 
            Grid.Row="1" 
            Content="_Read License Terms..."
            CommandParameter="{Binding $parent[Window]}"
            Command="{Binding ReadLicenseTermsCommand}"/>
        <Button 
            Grid.Row="2" 
            Content="C_heck for Updates..."
            CommandParameter="{Binding $parent[Window]}"
            Command="{Binding CheckForUpdatesCommand}"/>
        <Button
            Grid.Row="3"
            Name="CloseButton"
            Content="_Close"
            IsCancel="True"
            Margin="0, 10, 0, 0"
            Command="{Binding CloseCommand}"
            CommandParameter="{Binding $parent[Window]}" />
    </Grid>
</Window>